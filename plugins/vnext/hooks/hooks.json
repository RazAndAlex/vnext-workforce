{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_vnext_vnext__(delegate|retry|replace|send_message)",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "${CLAUDE_PLUGIN_ROOT}/wake.py"],
            "asyncRewake": true,
            "timeout": 1920
          }
        ]
      }
    ]
  }
}
